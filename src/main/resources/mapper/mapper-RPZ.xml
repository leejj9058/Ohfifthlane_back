<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="mapper-RPZ">

	<!-- 반경500미터 주차장만 가져오기 -->
	<select id="getNearRPZList"
		parameterType="com.team03.Ohfifthlane_back.vo.UserLocationVO"
		resultType="com.team03.Ohfifthlane_back.vo.RPZVO">

		SELECT * FROM ohfifthlane.rpz_tbl
		WHERE ST_DWithin(rpz_coord,
		ST_MakePoint(#{userLon}, #{userLat})::geography, 500)

	</select>
	

</mapper>